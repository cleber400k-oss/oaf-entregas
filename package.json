{
  "name": "oaf-entregas-backend",
  "version": "1.3.0",
  "private": true,
  "description": "OAF Entregas — publicação real, SQLite central, sincronização em tempo real e deploy cloud/VPS",
  "engines": {"node": ">=22.5.0"},
  "scripts": {
    "start": "node server.js",
    "start:prod": "node --env-file=.env.production server.js",
    "backup": "node --env-file-if-exists=.env.production scripts/backup.js",
    "restore": "node --env-file-if-exists=.env.production scripts/restore.js",
    "smoke": "node scripts/smoke-test.js",
    "validate": "node scripts/validate-package.js",
    "remote:smoke": "node scripts/remote-smoke.js"
  }
}
