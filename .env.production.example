# Copie para .env.production e altere os valores antes de publicar.
OAF_ENV=production
PORT=8787
OAF_BIND=0.0.0.0
OAF_SESSION_HOURS=168
OAF_TRUST_PROXY=1
OAF_COOKIE_SECURE=1
OAF_PUBLIC_URL=https://entregas.seudominio.com.br
OAF_DATA_DIR=/app/data
OAF_LOG_DIR=/app/logs
OAF_BACKUP_DIR=/app/backups
OAF_BACKUP_RETENTION_DAYS=30
# Gere um código de 6 dígitos e NÃO publique este arquivo.
OAF_SETUP_CODE=654321
OAF_REQUIRE_PERSISTENT_STORAGE=0
